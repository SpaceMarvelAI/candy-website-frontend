# Candy frontend (Vite) — DEV build env, used by deploy-dev.sh via --mode development.
# Every backend URL points at its dev-subdomain counterpart.
#
# Created 2026-09-01: this file never existed despite deploy-dev.sh's own comment expecting it
# ("--mode development picks up .env.development") -- dev builds were silently falling through to
# the shared, gitignored .env instead, which holds whatever value a prod/dev/staging deploy last
# left there locally. Found while chasing the candy -> Metaspace nav bug (VITE_META_APP_URL was
# stuck on a stale value for exactly this reason).

# --- Candy backend (this app's API) ---
VITE_API_BASE_URL=https://dev-api.candy.cx

# --- SpaceMarvel dashboard (identity/OIDC, plan, credits) ---
VITE_SM_API_URL=https://dashboard-api-dev.spacemarvel.ai

# --- Chat / MetaSpace backend (Composio cross-app calls) ---
VITE_META_API_URL=https://meta-api-dev.spacemarvel.ai

# --- Cross-product SSO redirect targets ("Open in X" from the sidebar) ---
VITE_META_APP_URL=https://dev.spacemarvel.ai
VITE_FINIXY_APP_URL=https://dev.finixy.ai

# PostHog intentionally NOT set here -- dev traffic should not mix into the same analytics
# project as prod.
