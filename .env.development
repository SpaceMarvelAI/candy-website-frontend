# Candy frontend (Vite) — DEV build env, used by deploy-dev.sh via --mode development.
# Mirrors .env (prod) but every backend URL points at its dev-subdomain counterpart instead.

# --- Candy backend (this app's API) ---
VITE_API_BASE_URL=https://dev-api.candy.cx

# --- SpaceMarvel dashboard (identity/OIDC, plan, credits) ---
VITE_SM_API_URL=https://dashboard-api-dev.spacemarvel.ai

# --- Chat / MetaSpace backend (Composio cross-app calls) ---
VITE_META_API_URL=https://meta-api-dev.spacemarvel.ai

# --- Cross-product SSO redirect targets ("Open in X" from the sidebar) ---
VITE_META_APP_URL=https://meta-dev.spacemarvel.ai
VITE_FINIXY_APP_URL=https://dev.finixy.ai

# PostHog — product analytics (same key as prod; PostHog distinguishes events by
# URL/host, not by a separate dev key)
VITE_PUBLIC_POSTHOG_KEY=phc_taobEqykUztJFQC6LLCjPs9LvSYbLZ7fiXFXdeXqMkMm
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
