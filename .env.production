# PROD env — loaded (on top of .env) by deploy-prod.sh's plain `npm run build`
# (Vite's default build mode is "production"). Authoritative source of truth for
# candy.spacemarvel.ai. Overrides any local .env changes so a stray local edit
# can never leak into a production deploy.
VITE_API_BASE_URL=https://candy-api.spacemarvel.ai
VITE_SM_API_URL=https://dashboard-api.spacemarvel.ai
VITE_META_API_URL=https://meta-api.spacemarvel.ai
