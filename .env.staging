# Candy frontend (Vite) — STAGING build env, used by a deploy-staging.sh via --mode staging.
# Mirrors .env.development but every backend URL points at its staging-subdomain counterpart instead.
# NOTE: staging-api.candy.cx / staging.finixy.ai etc. are not provisioned yet — see
# docs/deployment/STAGING_ENVIRONMENT_TODO.md. This file reflects where staging SHOULD point,
# not what's live today.

# --- Candy backend (this app's API) ---
VITE_API_BASE_URL=https://staging-api.candy.cx

# --- SpaceMarvel dashboard (identity/OIDC, plan, credits) ---
VITE_SM_API_URL=https://dashboard-api-staging.spacemarvel.ai

# --- Chat / MetaSpace backend (Composio cross-app calls) ---
VITE_META_API_URL=https://meta-api-staging.spacemarvel.ai

# --- Cross-product SSO redirect targets ("Open in X" from the sidebar) ---
VITE_META_APP_URL=https://staging.spacemarvel.ai
VITE_FINIXY_APP_URL=https://staging.finixy.ai

# PostHog intentionally NOT set here, same reasoning as .env.development — staging traffic
# should not mix into the same analytics project as prod.
